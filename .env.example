# Modèle des réglages secrets du site. Ce fichier ne contient AUCUN secret.
# Les vraies valeurs se saisissent dans Vercel (projet site-mme > Settings > Environment Variables),
# jamais dans le code. Pour un essai en local : copier ce fichier en .env.local (ignoré par Git).

# Formulaire de demande de médicaments : envoi par e-mail via Mailjet (déjà utilisé par la MME).
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Adresse d'expédition, validée dans le compte Mailjet de la MME (par exemple no-reply@mmesseghem.be).
MEDIC_EXPEDITEUR=
# Adresse qui reçoit les demandes (à décider par l'équipe).
MEDIC_DESTINATAIRE=
